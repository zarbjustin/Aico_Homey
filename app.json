  "flow": {
    "triggers": [
      {
        "id": "homelink_maintenance_reported",
        "title": {
          "en": "HomeLINK reports new maintenance alerts"
        },
        "hint": {
          "en": "Runs when Homey sees new faults or maintenance alerts for this device in a fresh HomeLINK refresh."
        },
        "tokens": [
          {
            "name": "new_count",
            "type": "number",
            "title": {
              "en": "New reports"
            },
            "example": 1
          },
          {
            "name": "active_count",
            "type": "number",
            "title": {
              "en": "Active reports"
            },
            "example": 2
          },
          {
            "name": "observed_at",
            "type": "string",
            "title": {
              "en": "Retrieved at (UTC)"
            },
            "example": "2026-06-01T12:30:00.000Z"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          }
        ]
      },
      {
        "id": "homelink_maintenance_cleared",
        "title": {
          "en": "HomeLINK stops reporting maintenance alerts"
        },
        "hint": {
          "en": "Runs when a fresh HomeLINK refresh reports zero active maintenance alerts after previously reporting one or more."
        },
        "tokens": [
          {
            "name": "previous_count",
            "type": "number",
            "title": {
              "en": "Previously active reports"
            },
            "example": 1
          },
          {
            "name": "observed_at",
            "type": "string",
            "title": {
              "en": "Retrieved at (UTC)"
            },
            "example": "2026-06-01T12:35:00.000Z"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          }
        ]
      },
      {
        "id": "homelink_fire_reported",
        "title": {
          "en": "HomeLINK reports a fire alarm"
        },
        "hint": {
          "en": "Preview. Runs on a newly observed cloud report when alarm Flow preview is enabled. Delivery can be delayed."
        },
        "tokens": [
          {
            "name": "new_count",
            "type": "number",
            "title": {
              "en": "New reports"
            },
            "example": 1
          },
          {
            "name": "observed_at",
            "type": "string",
            "title": {
              "en": "Retrieved at (UTC)"
            },
            "example": "2026-06-01T12:30:00.000Z"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          }
        ]
      },
      {
        "id": "homelink_co_reported",
        "title": {
          "en": "HomeLINK reports a carbon monoxide alarm"
        },
        "hint": {
          "en": "Preview. Runs on a newly observed cloud report when alarm Flow preview is enabled. Delivery can be delayed."
        },
        "tokens": [
          {
            "name": "new_count",
            "type": "number",
            "title": {
              "en": "New reports"
            },
            "example": 1
          },
          {
            "name": "observed_at",
            "type": "string",
            "title": {
              "en": "Retrieved at (UTC)"
            },
            "example": "2026-06-01T12:30:00.000Z"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "homelink_maintenance_active",
        "title": {
          "en": "HomeLINK reports !{{active|no active}} maintenance alerts"
        },
        "hint": {
          "en": "Checks the current HomeLINK snapshot and stops the Flow if maintenance data is unavailable."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          }
        ]
      },
      {
        "id": "homelink_maintenance_data_available",
        "title": {
          "en": "HomeLINK maintenance data !{{is|isn't}} available"
        },
        "hint": {
          "en": "Checks whether Homey has a valid, recent maintenance snapshot for this device."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          }
        ]
      },
      {
        "id": "homelink_replacement_due",
        "title": {
          "en": "Replacement !{{is|isn't}} due within a number of days"
        },
        "titleFormatted": {
          "en": "Replacement !{{is|isn't}} due within [[days]] days"
        },
        "hint": {
          "en": "Includes overdue devices and uses the replacement date reported by HomeLINK. A missing or stale date stops the Flow."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          },
          {
            "name": "days",
            "type": "number",
            "title": {
              "en": "Days"
            },
            "placeholder": {
              "en": "Days"
            },
            "min": 0,
            "step": 1
          }
        ]
      },
      {
        "id": "homelink_test_reminder",
        "title": {
          "en": "The last test !{{was|wasn't}} at least a number of days ago"
        },
        "titleFormatted": {
          "en": "The last test !{{was|wasn't}} at least [[days]] days ago"
        },
        "hint": {
          "en": "Uses Homey's local calendar and the last-test date reported by HomeLINK. A missing or stale date stops the Flow."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=homelink-device"
          },
          {
            "name": "days",
            "type": "number",
            "title": {
              "en": "Days"
            },
            "placeholder": {
              "en": "Days"
            },
            "min": 1,
            "step": 1
          }
        ]
      }
    ]
  },
