{
  "id": "uk.co.zarb.aico",
  "version": "0.11.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": ["local"],
  "brandColor": "#174555",
  "name": { "en": "Aico HomeLINK" },
  "description": { "en": "View Aico HomeLINK device status and maintenance alerts." },
  "category": ["security"],
  "tags": { "en": ["Aico", "HomeLINK", "SmartLINK"] },
  "permissions": [],
  "api": {
    "getConnectionStatus": { "method": "GET", "path": "/connection", "public": false },
    "checkConnection": { "method": "POST", "path": "/connection/check", "public": false },
    "getEventStatus": { "method": "GET", "path": "/events", "public": false },
    "getSupportReport": { "method": "GET", "path": "/diagnostics", "public": false }
  },
  "author": { "name": "zarbjustin" },
  "source": "https://github.com/zarbjustin/Aico_Homey",
  "support": "https://github.com/zarbjustin/Aico_Homey/issues",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  }
}
